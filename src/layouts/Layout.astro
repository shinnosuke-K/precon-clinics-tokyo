---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { url } from "../lib/format";
import { asof, baseTitle, siteDescription } from "../lib/clinics";

interface Props {
  title?: string;
  description?: string;
  /** canonical / og:url に使う、base を含まないサイト内パス */
  path?: string;
}
const { title = baseTitle, description = siteDescription, path = "" } = Astro.props;
const canonical = new URL(url(path), Astro.site).href;
const ogImage = new URL(url("asset/ogp.png"), Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href={url("asset/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("asset/favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={url("asset/apple-touch-icon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap" />
    <meta name="theme-color" content="#0f7c8a" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="登録医療機関リスト（非公式）" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="東京都 プレコンセプションケア 検査費等助成 登録医療機関リスト（個人作成の非公式サイト）" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content="東京都 プレコンセプションケア 検査費等助成 登録医療機関リスト（個人作成の非公式サイト）" />
    <link rel="canonical" href={canonical} />
    <slot name="head" />
    <script is:inline>
      /* 描画前にテーマを決めてちらつきを防ぐ。保存された選択がなければOS設定に追従 */
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        var d = t === "dark" || t === "light" ? t : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = d;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m && d === "dark") m.content = "#10191d";
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <footer>
      <div class="wrap">
        <ul>
          <li>掲載内容は各医療機関から提出された情報をそのまま記載しています。詳細は各医療機関へお問い合わせください。</li>
          <li>受診にあたり、本事業の助成対象ではない費用がかかる場合があります。予約の際にあらかじめご確認ください。</li>
          <li>料金は各機関が回答した時点のものです（各詳細の末尾に時点を記載）。表示は税込・円。</li>
          <li>このページは東京都福祉局「<a href="https://www.fukushi.metro.tokyo.lg.jp/kodomo/shussan/preconceptioncare" target="_blank" rel="noopener">プレコンセプションケア</a>」ページで公開されているExcel「登録医療機関リスト（{asof}）」を読みやすく組み直したものです。原本の記載を変更していません。</li>
          <li class="unofficial">本サイトは個人が作成した非公式のページであり、東京都・東京都福祉局が運営するものではありません。</li>
        </ul>
      </div>
    </footer>
  </body>
</html>
