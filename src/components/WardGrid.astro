---
import { wardsSorted } from "../lib/clinics";
import { areaPath } from "../lib/pages";
import { url } from "../lib/format";

const max = wardsSorted[0][1];
---

<section class="areas">
  <div class="wrap">
    <div class="sec-h">
      <h2>エリアから探す</h2>
      <span class="hint">クリックで絞り込み・もう一度で解除</span>
    </div>
    <div class="wardgrid" id="wards">
      {wardsSorted.map(([w, c], i) => (
        <a class:list={["ward", { more: i >= 8 }]} href={url(areaPath(w))} data-ward={w}>
          <span class="wn">{w}</span>
          <span class="wb"><i style={`width:${((c / max) * 100).toFixed(1)}%`}></i></span>
          <span class="wc">{c}</span>
        </a>
      ))}
      <button class="wtoggle">すべて表示（全{wardsSorted.length}エリア）</button>
    </div>
  </div>
</section>
